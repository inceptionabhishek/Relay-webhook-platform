generator client {
  provider = "prisma-client"
  output = "../src/generated/prisma"
  moduleFormat = "cjs"
}
datasource db {
  provider = "postgresql"
}
model User {
  id String @id @default(uuid())
  email String @unique
  name String
  passwordHash String
  createdAt DateTime @default(now())
  memberships Membership[]
  sessions Session[]
}
model Organization {
  id String @id @default(uuid())
  name String
  createdAt DateTime @default(now())
  eventRetentionDays Int?
  attemptRetentionDays Int?
  retentionLastRunAt DateTime?
  lastScheduledAt DateTime @default(dbgenerated("'1970-01-01 00:00:00'::timestamp without time zone"))
  memberships Membership[]
  endpoints Endpoint[]
  keys ApiKey[]
  events Event[]
  invitations Invitation[]
  audits AuditLog[]
  replayBatches ReplayBatch[]
  retentionRuns RetentionRun[]
  expiredEvents ExpiredEvent[]
  alertRules AlertRule[]
  alerts Alert[]
}
model Membership {
  userId String
  organizationId String
  role String @default("member")
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  @@id([userId, organizationId])
}
model Session {
  id String @id @default(uuid())
  tokenHash String @unique
  userId String
  expiresAt DateTime
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([expiresAt])
}
model ApiKey {
  id String @id @default(uuid())
  organizationId String
  name String
  prefix String
  tokenHash String @unique
  createdAt DateTime @default(now())
  revokedAt DateTime?
  scopes String[] @default(["events:publish"])
  eventTypes String[] @default([])
  expiresAt DateTime?
  lastUsedAt DateTime?
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  @@index([organizationId])
}
model Endpoint {
  id String @id @default(uuid())
  organizationId String
  name String
  url String
  secretEncrypted String
  previousSecretEncrypted String?
  previousSecretUntil DateTime?
  enabled Boolean @default(true)
  eventTypes String[] @default([])
  createdAt DateTime @default(now())
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  deliveries Delivery[]
  circuitTransitions CircuitTransition[]
  monitoredRules AlertRule[] @relation("MonitoredEndpoint")
  notificationRules AlertRule[] @relation("NotificationEndpoint")
  alerts Alert[]
  @@index([organizationId, createdAt])
}
model Event {
  id String @id @default(uuid())
  organizationId String
  type String
  payload Json
  idempotencyKey String
  requestHash String
  traceContext Json @default("{}")
  source String @default("production")
  notifications AlertNotification[]
  createdAt DateTime @default(now())
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  deliveries Delivery[]
  @@unique([organizationId, idempotencyKey])
  @@index([organizationId, createdAt])
}
model Delivery {
  id String @id @default(uuid())
  eventId String
  endpointId String
  status String @default("pending")
  generation Int @default(0)
  attemptCount Int @default(0)
  failureCount Int @default(0)
  scheduleCount Int @default(0)
  nextAttemptAt DateTime @default(now())
  leaseUntil DateTime?
  leaseToken String?
  lastError String?
  deliveredAt DateTime?
  finishedAt DateTime?
  createdAt DateTime @default(now())
  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  endpoint Endpoint @relation(fields: [endpointId], references: [id])
  attempts Attempt[]
  outbox Outbox[]
  replayItems ReplayItem[]
  @@unique([eventId, endpointId])
  @@index([status, nextAttemptAt])
  @@index([endpointId, status, nextAttemptAt])
}
model Attempt {
  id String @id @default(uuid())
  deliveryId String
  number Int
  generation Int
  statusCode Int?
  durationMs Int
  responseSnippet String?
  error String?
  outcome String
  requestHeaders Json?
  requestBody String?
  createdAt DateTime @default(now())
  delivery Delivery @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
  @@index([deliveryId, createdAt])
}
model Outbox {
  id String @id @default(uuid())
  deliveryId String
  generation Int
  sequence Int @default(0)
  availableAt DateTime @default(now())
  dispatchedAt DateTime?
  completedAt DateTime?
  createdAt DateTime @default(now())
  delivery Delivery @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
  @@unique([deliveryId, generation, sequence])
  @@index([dispatchedAt, availableAt])
}
model CircuitTransition {
  id String @id @default(uuid())
  endpointId String
  fromState String
  toState String
  reason String
  createdAt DateTime @default(now())
  endpoint Endpoint @relation(fields: [endpointId], references: [id], onDelete: Cascade)
  @@index([endpointId, createdAt])
}
model ReplayBatch {
  id String @id @default(uuid())
  organizationId String
  actor String
  idempotencyKey String
  requestHash String
  createdAt DateTime @default(now())
  completedAt DateTime?
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  items ReplayItem[]
  @@unique([organizationId, idempotencyKey])
  @@index([organizationId, createdAt])
}
model ReplayItem {
  id String @id @default(uuid())
  batchId String
  deliveryId String?
  originalDeliveryId String
  expectedGeneration Int
  replayGeneration Int?
  status String @default("queued")
  error String?
  batch ReplayBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  delivery Delivery? @relation(fields: [deliveryId], references: [id], onDelete: SetNull)
  @@unique([batchId, originalDeliveryId])
  @@index([status, batchId])
}
model Invitation {
  id String @id @default(uuid())
  organizationId String
  email String
  tokenHash String @unique
  expiresAt DateTime
  acceptedAt DateTime?
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  @@index([organizationId])
}
model AuditLog {
  id String @id @default(uuid())
  organizationId String
  actor String
  action String
  resourceId String?
  createdAt DateTime @default(now())
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  @@index([organizationId, createdAt])
}

model ExpiredEvent {
  id String @id @default(uuid())
  organizationId String
  eventId String @unique
  idempotencyKey String
  requestHash String
  expiredAt DateTime @default(now())
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  @@unique([organizationId, idempotencyKey])
}
model RetentionRun {
  id String @id @default(uuid())
  organizationId String
  eventsDeleted Int
  attemptsDeleted Int
  createdAt DateTime @default(now())
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  @@index([organizationId, createdAt])
}
model AlertRule {
  id String @id @default(uuid())
  organizationId String
  name String
  enabled Boolean @default(true)
  endpointId String?
  notificationEndpointId String?
  threshold Int @default(3)
  windowMinutes Int @default(15)
  cooldownMinutes Int @default(30)
  lastEvaluatedAt DateTime @default(dbgenerated("'1970-01-01 00:00:00'::timestamp without time zone"))
  createdAt DateTime @default(now())
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  endpoint Endpoint? @relation("MonitoredEndpoint", fields: [endpointId], references: [id], onDelete: SetNull)
  notificationEndpoint Endpoint? @relation("NotificationEndpoint", fields: [notificationEndpointId], references: [id], onDelete: SetNull)
  alerts Alert[]
  @@index([enabled, lastEvaluatedAt])
}
model Alert {
  id String @id @default(uuid())
  organizationId String
  ruleId String
  endpointId String
  activeKey String? @unique
  message String
  failureCount Int
  acknowledgedAt DateTime?
  resolvedAt DateTime?
  createdAt DateTime @default(now())
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  rule AlertRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  endpoint Endpoint @relation(fields: [endpointId], references: [id], onDelete: Cascade)
  notifications AlertNotification[]
  @@index([organizationId, createdAt])
}
model AlertNotification {
  id String @id @default(uuid())
  alertId String
  eventId String? @unique
  phase String
  createdAt DateTime @default(now())
  alert Alert @relation(fields: [alertId], references: [id], onDelete: Cascade)
  event Event? @relation(fields: [eventId], references: [id], onDelete: SetNull)
  @@unique([alertId, phase])
}
